# Local PostgreSQL connection (see docs/data-model.md). Copy this file to
# .env and fill in the real values — .env is gitignored.
# On Railway (or any pooled/serverless target), append a low connection_limit
# (e.g. &connection_limit=3) — see best-practices.md §Prisma / SQL, needed
# because every Lambda cold start can open a new connection.
DATABASE_URL="postgresql://flyworkflow_app:password@localhost:5432/flyworkflow?schema=public"

# Local dev server port
PORT=3001
