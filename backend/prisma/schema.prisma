// FlyWorkFlow backend — Prisma schema.
// Source of truth for entities from this point on (docs/data-model.md at the
// repository root now follows this file, not the other way around).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  admin
  superadmin
}

enum IncidentPriority {
  high
  medium
  low
}

enum IncidentStatus {
  open
  on_pause
  closed
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum MediaType {
  image
  video
  document
}

enum MediaStatus {
  uploaded
  pending
  error
}

enum AuditAction {
  created
  updated
  status_changed
  approved
  rejected
  deleted
  restored
}

enum NotificationType {
  assignment
  status_changed
  approval
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users         User[]
  projects      Project[]
  tags          Tag[]
  incidents     Incident[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model User {
  id           String   @id @default(uuid())
  orgId        String
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(member)
  avatarUrl    String?
  createdAt    DateTime @default(now())

  organization      Organization       @relation(fields: [orgId], references: [id])
  ownedIncidents    Incident[]         @relation("IncidentOwner")
  assignedIncidents IncidentAssignee[]
  observedIncidents IncidentObserver[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  notifications     Notification[]     @relation("NotificationRecipient")

  @@index([orgId])
}

model Project {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  incidents    Incident[]

  @@index([orgId])
}

// Shared catalog, not organization-dependent — same 15 keys for every tenant.
model IncidentType {
  id     String @id @default(uuid())
  key    String @unique
  name   String
  nameEn String

  incidents Incident[]
}

model Incident {
  id          String @id @default(uuid())
  sequenceId  String
  orgId       String
  projectId   String
  typeId      String
  title       String
  description String

  priority IncidentPriority
  status   IncidentStatus
  approval ApprovalStatus   @default(pending)

  ownerId String

  deleted Boolean @default(false)

  // Embedded point, not a relation (see docs/data-model.md) — modeled as two
  // nullable scalars rather than Json so it stays directly queryable/typed.
  lat Float?
  lng Float?

  locationDescription String?
  dueDate             DateTime?
  closingDate         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id])
  type         IncidentType @relation(fields: [typeId], references: [id])
  owner        User         @relation("IncidentOwner", fields: [ownerId], references: [id])

  assignees     IncidentAssignee[]
  observers     IncidentObserver[]
  tags          IncidentTag[]
  media         Media[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@unique([orgId, sequenceId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}

model IncidentAssignee {
  incidentId String
  userId     String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([incidentId, userId])
}

model IncidentObserver {
  incidentId String
  userId     String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@id([incidentId, userId])
}

model Tag {
  id    String @id @default(uuid())
  orgId String
  name  String
  color String

  organization Organization  @relation(fields: [orgId], references: [id])
  incidents    IncidentTag[]

  @@index([orgId])
}

model IncidentTag {
  incidentId String
  tagId      String

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([incidentId, tagId])
}

model Media {
  id         String      @id @default(uuid())
  incidentId String
  name       String
  type       MediaType
  format     String
  size       Int
  status     MediaStatus
  url        String
  createdAt  DateTime    @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id         String      @id @default(uuid())
  orgId      String
  incidentId String
  actorId    String
  action     AuditAction
  metadata   Json
  createdAt  DateTime    @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor        User         @relation("AuditActor", fields: [actorId], references: [id])

  @@index([incidentId])
}

model Notification {
  id          String           @id @default(uuid())
  orgId       String
  recipientId String
  incidentId  String
  type        NotificationType
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  recipient    User         @relation("NotificationRecipient", fields: [recipientId], references: [id])
  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
}
