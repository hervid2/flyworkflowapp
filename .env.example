# Mapbox GL public token — get yours at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# App URL (used for absolute redirects in middleware)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the FlyWorkFlow backend (see backend/.env.example). Local dev:
# the plain NestJS server, not SAM (localhost:3001). Production: the deployed
# API Gateway URL, set as a Vercel project env var.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Verifies the access token's signature/expiration at the Edge in
# middleware.ts. Must be byte-identical to the backend's JWT_ACCESS_SECRET —
# never NEXT_PUBLIC_-prefixed, so it stays out of the browser bundle. In
# production this is a Vercel project env var, set to match the AWS SAM
# NoEcho parameter.
JWT_ACCESS_SECRET=replace-with-the-backend-s-JWT_ACCESS_SECRET
